# JingCang production deployment configuration
JINGCANG_IMAGE_TAG=1.2.1
JINGCANG_BROWSER_BUNDLE_TAG=1.2.1
JINGCANG_BIND_HOST=0.0.0.0
JINGCANG_PORT=8088

JINGCANG_BASE_URL=http://localhost:8088
JINGCANG_PUBLIC_HOSTNAME=jingcang.localhost
JINGCANG_TIMEZONE=Asia/Shanghai

JINGCANG_SESSION_DEFAULT_MINUTES=60
JINGCANG_SESSION_MAX_MINUTES=120
JINGCANG_SESSION_IDLE_MINUTES=30
JINGCANG_SESSION_MAX_CONCURRENCY=4
JINGCANG_SESSION_QUEUE_LIMIT=10
JINGCANG_SELENIUM_SESSION_TIMEOUT=7200

JINGCANG_ARTIFACT_RETENTION_DAYS=7
JINGCANG_ARTIFACT_MAX_TOTAL_GB=50
JINGCANG_VIEWER_TOKEN_TTL_SECONDS=120

JINGCANG_LAN_ACCESS_ENABLED=true
JINGCANG_TRUST_PROXY=true

JINGCANG_BROWSER_COMPOSE_PROJECT=jingcang-poc
JINGCANG_BROWSER_COMPOSE_NETWORK=jingcang_poc

# Browser image source. Examples:
#   selenium
#   registry.example.com/team/selenium
JINGCANG_BROWSER_IMAGE_REPOSITORY_PREFIX=selenium
# Optional private registry credentials. Leave empty for public/anonymous registries.
JINGCANG_BROWSER_REGISTRY_SERVER=
JINGCANG_BROWSER_REGISTRY_USERNAME=
JINGCANG_BROWSER_REGISTRY_PASSWORD=
# Set true on servers that must never query/pull from the public Internet.
JINGCANG_BROWSER_OFFLINE_MODE=false
# When empty, defaults to true in offline mode and false otherwise.
# Set true to auto-discover local Selenium images, start their nodes, and sync them into the browser catalog.
JINGCANG_BROWSER_AUTO_SYNC_LOCAL_IMAGES=
# Automatically rescan ./browser-images for docker-save archives.
JINGCANG_BROWSER_IMAGE_SCAN_INTERVAL_SECONDS=30

# Replace these values before deployment. bootstrap-production.ps1 does this automatically.
JINGCANG_SESSION_SECRET=change-me-session-secret-min-32-chars
JINGCANG_VIEWER_SECRET=change-me-viewer-secret-min-32-chars
JINGCANG_ADMIN_INITIAL_PASSWORD=change-me-admin-password-min-12-chars
