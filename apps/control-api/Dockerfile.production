ARG NODE_IMAGE=node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9

FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/browser-catalog/package.json packages/browser-catalog/package.json
COPY apps/control-api/package.json apps/control-api/package.json
COPY apps/console-web/package.json apps/console-web/package.json
RUN pnpm install --frozen-lockfile

COPY packages ./packages
COPY apps/control-api ./apps/control-api
COPY apps/console-web ./apps/console-web
RUN pnpm --filter @jingcang/contracts build \
 && pnpm --filter @jingcang/browser-catalog build \
 && pnpm --filter @jingcang/console-web build \
 && pnpm --filter @jingcang/control-api build

FROM ${NODE_IMAGE} AS prod-deps
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/browser-catalog/package.json packages/browser-catalog/package.json
COPY apps/control-api/package.json apps/control-api/package.json
COPY apps/console-web/package.json apps/console-web/package.json
RUN pnpm install --frozen-lockfile --prod --filter @jingcang/control-api...

FROM ${NODE_IMAGE} AS runtime
ARG VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="JingCang Control API" \
      org.opencontainers.image.description="JingCang local browser compatibility testing platform" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/programmerguohuajing/jingcang"

ENV NODE_ENV=production
ENV JINGCANG_ROOT=/app
ENV JINGCANG_CONTAINERIZED=true
ENV JINGCANG_PORT=8088
ENV JINGCANG_BIND_HOST=0.0.0.0
ENV JINGCANG_LAN_ACCESS_ENABLED=true

WORKDIR /app

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/apps/control-api/node_modules ./apps/control-api/node_modules
COPY --from=prod-deps /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=prod-deps /app/packages/browser-catalog/node_modules ./packages/browser-catalog/node_modules

COPY package.json ./
COPY apps/control-api/package.json ./apps/control-api/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/browser-catalog/package.json ./packages/browser-catalog/package.json

COPY --from=build /app/apps/control-api/dist ./apps/control-api/dist
COPY --from=build /app/apps/console-web/dist ./apps/console-web/dist
COPY --from=build /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=build /app/packages/browser-catalog/dist ./packages/browser-catalog/dist
COPY deploy/selenium/browser-catalog.production.yaml ./deploy/selenium/browser-catalog.yaml

RUN mkdir -p /app/data/db /app/data/artifacts /app/data/logs

EXPOSE 8088

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8088/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "apps/control-api/dist/server.js"]
